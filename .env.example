# Optional: enables the AI coach. Without it the app uses its on-device coach.
# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# Required in production when ANTHROPIC_API_KEY is set: a long random secret.
# Enter the same value in the app under Profile → AI coach → Access token.
COACH_ACCESS_TOKEN=

# Optional: model for the AI coach (defaults to claude-opus-5-5).
# COACH_MODEL=claude-opus-5-5

# Not recommended: allow the AI endpoint without a token in production.
# COACH_ALLOW_OPEN=false
